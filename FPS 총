import streamlit as st
import streamlit.components.v1 as components

st.set_page_config(page_title="Streamlit 3D Target Shooter", layout="wide")

st.title("🎯 Streamlit 3D 타겟 슈팅 게임")
st.write("화면 중앙의 **[게임 시작]**을 클릭하면 마우스 포인터가 가물어지며 시점이 고정됩니다. 화면 중앙의 빨간 타겟을 사격하세요! (ESC 키를 누르면 마우스 제어가 해제됩니다)")

# Three.js 기반 3D FPS 웹 게임 HTML/JS 코드
fps_game_html = """
<!DOCTYPE html>
<html>
<head>
    <style>
        body { margin: 0; overflow: hidden; background-color: #111; font-family: sans-serif; }
        #canvas-container { width: 100vw; height: 80vh; position: relative; }
        #crosshair {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 10px;
            height: 10px;
            margin-top: -5px;
            margin-left: -5px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.8);
            border: 2px solid black;
            pointer-events: none;
            z-index: 10;
        }
        #ui {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            font-size: 20px;
            font-weight: bold;
            z-index: 10;
            background: rgba(0,0,0,0.5);
            padding: 10px 20px;
            border-radius: 8px;
        }
        #instructions {
            position: absolute;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: rgba(0,0,0,0.7);
            color: white;
            font-size: 24px;
            cursor: pointer;
            z-index: 20;
        }
    </style>
    <!-- Three.js 및 PointerLockControls 불러오기 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <div id="canvas-container">
        <div id="crosshair"></div>
        <div id="ui">점수: <span id="score">0</span></div>
        <div id="instructions">
            <div>클릭하여 게임 시작 (마우스로 조준, 클릭하여 사격)</div>
        </div>
    </div>

    <script>
        let scene, camera, renderer, target;
        let score = 0;
        let isLocked = false;

        const container = document.getElementById('canvas-container');
        const instructions = document.getElementById('instructions');
        const scoreElem = document.getElementById('score');

        function init() {
            // 1. Scene 설정
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x222233);

            // 2. Camera 설정
            camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(0, 1.6, 0); // 플레이어 눈높이

            // 3. Renderer 설정
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            // 4. 조명
            const light = new THREE.DirectionalLight(0xffffff, 1);
            light.position.set(5, 10, 7.5);
            scene.add(light);
            scene.add(new THREE.AmbientLight(0x404040));

            // 5. 바닥 생성
            const gridHelper = new THREE.GridHelper(50, 50, 0x00ff00, 0x444444);
            gridHelper.position.y = 0;
            scene.add(gridHelper);

            // 6. 타겟 생성
            createTarget();

            // 이벤트 리스너
            instructions.addEventListener('click', () => {
                container.requestPointerLock();
            });

            document.addEventListener('pointerlockchange', () => {
                if (document.pointerLockElement === container) {
                    instructions.style.display = 'none';
                    isLocked = true;
                } else {
                    instructions.style.display = 'flex';
                    isLocked = false;
                }
            });

            document.addEventListener('mousemove', (e) => {
                if (!isLocked) return;
                
                // 마우스 이동으로 시점 회전
                camera.rotation.y -= e.movementX * 0.002;
                camera.rotation.x -= e.movementY * 0.002;

                // 상하 시점 제한
                camera.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, camera.rotation.x));
                camera.rotation.order = "YXZ";
            });

            document.addEventListener('mousedown', (e) => {
                if (!isLocked || e.button !== 0) return;
                shoot();
            });

            window.addEventListener('resize', onWindowResize);
            animate();
        }

        function createTarget() {
            if (target) scene.remove(target);

            const geometry = new THREE.SphereGeometry(0.8, 32, 32);
            const material = new THREE.MeshLambertMaterial({ color: 0xff3333 });
            target = new THREE.Mesh(geometry, material);

            // 랜덤 위치 지정
            target.position.x = (Math.random() - 0.5) * 20;
            target.position.y = 1 + Math.random() * 3;
            target.position.z = -5 - Math.random() * 15;

            scene.add(target);
        }

        function shoot() {
            // 레이캐스팅으로 사격 처리
            const raycaster = new THREE.Raycaster();
            raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);

            const intersects = raycaster.intersectObject(target);

            if (intersects.length > 0) {
                score += 10;
                scoreElem.innerText = score;
                createTarget(); // 타겟 재생성
            }
        }

        function onWindowResize() {
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }

        init();
    </script>
</body>
</html>
"""

# Streamlit에 HTML 컴포넌트로 삽입
components.html(fps_game_html, height=700)
